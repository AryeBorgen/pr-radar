{
  "name": "pr-radar",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "description": "Every open pull request across all your repositories, on one screen. Static, backend-free, bring your own repos.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build && npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node bin/pr-radar.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run build:lib && npm run test:package",
    "test:browser": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run build:lib && npm run test:package && npm run test:types && npm run test:browser",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "test:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints style.css",
    "test:types": "tsc -p tsconfig.consumer.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "publint": "^0.3.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "github",
    "pull-requests",
    "dashboard",
    "code-review",
    "cli",
    "self-hosted"
  ],
  "homepage": "https://github.com/AryeBorgen/pr-radar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryeBorgen/pr-radar.git"
  },
  "bugs": {
    "url": "https://github.com/AryeBorgen/pr-radar/issues"
  },
  "bin": {
    "pr-radar": "bin/pr-radar.js"
  },
  "files": [
    "dist",
    "dist-lib",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./render": {
      "types": "./dist-lib/types/render.d.ts",
      "import": "./dist-lib/render.js"
    },
    "./style.css": "./dist-lib/pr-radar.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {}
}
