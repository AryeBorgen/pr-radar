{
  "name": "pr-radar",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Every open pull request across all your repositories, on one screen. Static, backend-free, bring your own repos.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node bin/pr-radar.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "github",
    "pull-requests",
    "dashboard",
    "code-review",
    "cli",
    "self-hosted"
  ],
  "homepage": "https://github.com/AryeBorgen/pr-radar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryeBorgen/pr-radar.git"
  },
  "bugs": {
    "url": "https://github.com/AryeBorgen/pr-radar/issues"
  },
  "bin": {
    "pr-radar": "bin/pr-radar.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
